[flake8]
# Exclude common virtual environment and build directories so only our code is linted.
exclude = .venv,venv,env,.env,dist,build,__pycache__,.git,.mypy_cache,.pytest_cache,.tox,site-packages
# Keep default line length; adjust if project requires different limit.
max-line-length = 120
# Ignore import order and some common test warnings if needed in future:
# extend-ignore = 
