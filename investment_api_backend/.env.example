# Application
APP_NAME=Investment API
APP_DESCRIPTION=Backend API for investment analysis, integrations, auth, onboarding, portfolio, and compliance.
APP_VERSION=0.1.0

# Security
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
PASSWORD_HASH_SCHEME=bcrypt

# CORS
BACKEND_CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com
CORS_ALLOW_CREDENTIALS=true

# Database (either provide POSTGRES_URL or the discrete parts below)
POSTGRES_URL=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=investment
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# External APIs (optional)
ALPHA_VANTAGE_API_KEY=
ALPACA_API_KEY=
ALPACA_API_SECRET=
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
YAHOO_FINANCE_ENABLED=true

# Pricing
REGISTRATION_FEE_USD=0.0
SUBSCRIPTION_MONTHLY_USD=0.0

# Site URL for email redirects (optional)
SITE_URL=http://localhost:3000
