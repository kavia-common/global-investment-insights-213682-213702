# Backend environment example

# App
APP_NAME=Investment API
APP_DESCRIPTION=Backend API for investment analysis, integrations, auth, onboarding, portfolio, and compliance.
APP_VERSION=0.1.0

# Security / JWT
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
PASSWORD_HASH_SCHEME=bcrypt

# CORS (comma-separated origins, include scheme and port)
BACKEND_CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Database (option A: single URL)
# IMPORTANT: For SQLAlchemy + psycopg2, prefix should be postgresql+psycopg2://
POSTGRES_URL=postgresql+psycopg2://appuser:dbuser123@localhost:5000/myapp

# Database (option B: discrete parts; used only if POSTGRES_URL is not set)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5000
# POSTGRES_DB=myapp
# POSTGRES_USER=appuser
# POSTGRES_PASSWORD=dbuser123

# External services (optional stubs)
# ALPHA_VANTAGE_API_KEY=
# ALPACA_API_KEY=
# ALPACA_API_SECRET=
# ZERODHA_API_KEY=
# ZERODHA_API_SECRET=

# Pricing (optional)
# REGISTRATION_FEE_USD=0.0
# SUBSCRIPTION_MONTHLY_USD=0.0

# Frontend site URL (optional)
# SITE_URL=http://localhost:3000
